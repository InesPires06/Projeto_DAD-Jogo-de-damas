{
  "info": {
    "name": "DAD - Project",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "description": "",
            "url": {
              "raw": "{{url}}/login",
              "protocol": "",
              "host": [
                "{{url}}"
              ],
              "path": [
                "login"
              ],
              "query": [],
              "variable": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\":\"test@example.com\",\n  \"password\":\"password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "packages": {},
                "requests": {},
                "exec": [
                  "pm.collectionVariables.set(\"token\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "disabled": false,
                "type": "default"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "description": "",
            "url": {
              "raw": "{{url}}/users/me",
              "protocol": "",
              "host": [
                "{{url}}"
              ],
              "path": [
                "users",
                "me"
              ],
              "query": [],
              "variable": []
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "disabled": false,
                "type": "default"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "description": "",
            "url": {
              "raw": "{{url}}/logout",
              "protocol": "",
              "host": [
                "{{url}}"
              ],
              "path": [
                "logout"
              ],
              "query": [],
              "variable": []
            },
            "body": {
              "mode": "raw",
              "raw": "",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "packages": {},
                "requests": {},
                "exec": [
                  "pm.collectionVariables.set(\"token\", \"\");"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "url",
      "value": "http://localhost:8000/api",
      "type": "default"
    },
    {
      "key": "token",
      "value": "",
      "type": "default"
    }
  ]
}